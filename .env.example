# Supabase (required) — see canonical definitions in the REQUIRED block below.

# Enable the AI assistant in the frontend (set to "true" to use the Edge Function)
VITE_ENABLE_AI=true

# LLM provider keys (optional - required to use real LLMs)
# Add one or both depending on your preferred provider
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=...

# To run Supabase Edge Functions locally you will need a service role key
SUPABASE_SERVICE_ROLE_KEY=service-role-...
# ========================================
# ISLAKAYD ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!

# ----------------------------------------
# REQUIRED - Application will not work without these
# ----------------------------------------

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ----------------------------------------
# OPTIONAL - Enhanced functionality
# ----------------------------------------

# Stripe Payment Processing
# Get from: https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_...) for development
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key

# Google Analytics 4
# Get from: https://analytics.google.com/
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_ENABLE_ANALYTICS=true

# Sentry Error Tracking (Recommended for production)
# Get from: https://sentry.io/settings/projects/your-project/keys/
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry release tag — used by errorMonitoring.ts to tag events with the
# build version. Defaults to "development" when unset. Set in CI/CD to
# git SHA, package.json version, or similar.
VITE_APP_VERSION=development

# ----------------------------------------
# SOCIAL LINKS (footer links)
# ----------------------------------------
# Footer.tsx reads each of these and only renders an icon if the URL is set.
VITE_FACEBOOK_URL=
VITE_TWITTER_URL=
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_YOUTUBE_URL=

# ----------------------------------------
# FEATURE FLAGS
# ----------------------------------------
VITE_ENABLE_PWA=true
VITE_ENABLE_AI_ASSISTANT=true

# ----------------------------------------
# DEVELOPMENT SETTINGS
# ----------------------------------------

# Application URLs
# VITE_APP_URL is the canonical, externally reachable origin (e.g.
# https://islakayd.com). Used by getPublicAppUrl() when building shareable
# invite/referral/split-payment links. REQUIRED in Capacitor mobile
# builds — otherwise share links default to capacitor://localhost.
# Web builds may leave this unset; it falls back to window.location.origin.
VITE_APP_URL=http://localhost:5173
VITE_API_URL=https://your-project-id.supabase.co/functions/v1

# Development Mode (use demo data without backend)
VITE_DEMO_MODE=false

# Enable debug logging
VITE_DEBUG=false

# ----------------------------------------
# NOTES
# ----------------------------------------
# • Required variables MUST be set for the app to work
# • Use test/development keys during development
# • Never share or commit your .env.local file
# • See SETUP_GUIDE.md for step-by-step configuration

# VAPID Push Notifications
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@islakayd.com
