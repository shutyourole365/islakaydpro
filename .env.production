# Production environment variables.
#
# The Supabase URL and the publishable (anon) key are PUBLIC, client-side
# values — they are embedded in the browser bundle by design and access is
# governed by Row Level Security. They are safe to commit.
#
# NEVER put the Supabase secret/service-role key or the Stripe SECRET key
# here — those belong only in server-side secret stores (Supabase Edge
# Function secrets), never in the client build.

VITE_SUPABASE_URL=https://yhzmgjzshadmcgencccj.supabase.co
# Legacy anon JWT key — the broadly-compatible client key format for
# @supabase/supabase-js. Public, client-side value protected by RLS (safe to
# commit). The newer sb_publishable_ key works on recent supabase-js versions
# too; the legacy JWT is used here to avoid depending on the resolved version.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inloem1nanpzaGFkbWNnZW5jY2NqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAwNTU2MjYsImV4cCI6MjA5NTYzMTYyNn0.qAAM9-9rXnePzwUyiosf42Fby2JWNOFgdNuPxT_2L20
VITE_ENABLE_AI=true

# Stripe publishable key (pk_test_... / pk_live_...) — optional, set when wiring payments.
VITE_STRIPE_PUBLIC_KEY=
