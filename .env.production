# Production environment variables.
#
# The Supabase URL and the publishable (anon) key are PUBLIC, client-side
# values — they are embedded in the browser bundle by design and access is
# governed by Row Level Security. They are safe to commit.
#
# NEVER put the Supabase secret/service-role key or the Stripe SECRET key
# here — those belong only in server-side secret stores (Supabase Edge
# Function secrets), never in the client build.

VITE_SUPABASE_URL=https://yhzmgjzshadmcgencccj.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_RFWprjf3fXv-31Pe7FykyA_0uNOyvEz
VITE_ENABLE_AI=true

# Stripe publishable key (pk_test_... / pk_live_...) — optional, set when wiring payments.
VITE_STRIPE_PUBLIC_KEY=
